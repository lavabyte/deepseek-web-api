# Server port — the ONLY required variable.
PORT=8787
#
# Optional (all have verified defaults):
# HOST=127.0.0.1
# MODEL_ID=deepseek/deepseek-v4-flash
# MAX_PROMPT_CHARS=1000000
# AUTO_CONTINUE=1
# MAX_CONTINUATIONS=1
# IDLE_TIMEOUT_MS=120000
# DATA_DIR=

# NOTE: the session token is NOT here. The client passes it as the API key:
#   Authorization: Bearer <token-from-chat.deepseek.com>
# Several accounts may be listed, comma-separated:
#   Authorization: Bearer tok1,tok2,tok3
# A session token is Base64 (letters, digits, +, /, =), so a comma never occurs inside
# one — the split is unambiguous. Each token is a separate account, and the pool spreads
# concurrent requests across them. A single token with no comma behaves exactly as before.
# This way the server stores no secret.

# 429 pause (built in, needs no configuration):
#   When DeepSeek replies 429, the account gets a 2-minute cooldown. During that
#   time the server answers locally with 429 + retry-after and sends NOTHING to
#   DeepSeek — contacting it would reset the throttle window and extend the block.
#   Cooldown state lives in data/rate-limits.json (survives a server restart).
#   Clear it manually by deleting that file.
# RATE_LIMIT_COOLDOWN_MS=120000   # cooldown length (default 2 minutes)

# -- Token pool --
# POOL_ATTEMPTS=3             # how many accounts one request may try before giving up.
#                              # On failure the request ROTATES to the next account, so up to
#                              # 3 different accounts are tried; if one full pass still fails,
#                              # the last error is returned. For streaming, rotation happens
#                              # only before the SSE head is sent (after that the HTTP status
#                              # can no longer change). With fewer tokens than this, one pass
#                              # over all of them is the limit.
# POOL_ROTATE_DELAY_MS=400    # short pause before a request retries on the next account,
#                              # so a sick account is not hammered again immediately
# POOL_QUEUE_TIMEOUT_MS=300000 # how long to wait for a free account before giving up
# TOKEN_VERIFY_TIMEOUT_MS=20000 # limit for the first-use token verification
# ALLOW_CONCURRENT=1           # 1 = do not lock an account while it generates (by default
#                              # one account serves one request at a time)

# -- Access control (disabled by default — every valid token passes) --
# List of allowed tokens as sha256 digests (32 hex chars), comma-separated. Checked per
# token: a key may list several accounts and only some may be allowed.
# "all" or empty = no restriction. Compute a digest like this:
#   node -e "console.log(require('crypto').createHash('sha256').update('<token>').digest('hex').slice(0,32))"
# ACCESS_ALLOWLIST=all

# -- Per-token quotas (disabled by default) --
# QUOTA_MAX_REQUESTS=0        # 0 = unlimited; otherwise requests per window
# QUOTA_WINDOW_MS=3600000     # window length (default 1 hour)

# -- Session state cleanup --
# SESSION_TTL_MS=2592000000    # drop sessions unused for 30 days (0 = never)
# SESSION_MAX_ENTRIES=1000     # hard cap on the number of stored sessions

# -- Logs (production) --
# LOG_LEVEL=info               # debug | info | warn | error
# LOG_FORMAT=json              # json (default outside a TTY) | text
# TRUST_PROXY=1                # read X-Forwarded-For (ONLY behind a reverse proxy)

# -- Timeouts and shutdown --
# HEADERS_TIMEOUT_MS=30000     # slow-loris protection
# REQUEST_TIMEOUT_MS=300000
# KEEP_ALIVE_TIMEOUT_MS=65000
# SHUTDOWN_TIMEOUT_MS=10000    # graceful shutdown on SIGTERM
